# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# ─────────────────────────────────────────────────────────────

# ── Required (the server refuses to start if any of these is missing) ──

# MongoDB connection string. Must point at a REPLICA SET (MongoDB Atlas is one) —
# order creation runs in a transaction, which requires a replica set.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/aveniq
MONGO_URI=

# Secret used to sign JWT auth tokens. Use a long, random string.
JWT_SECRET=

# Google OAuth 2.0 credentials (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImageKit private key (ImageKit dashboard → Developer options). Used to upload product images.
IMAGEKIT_PRIVATE_KEY=

# SMTP credentials used to send password-reset emails.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# "From" address for outgoing email.
EMAIL_FROM=

# Absolute URL of the frontend. Used for CORS, OAuth redirects and reset links.
# Example: https://your-app.vercel.app   (dev: http://localhost:5173)
CLIENT_URL=

# Razorpay API keys (Razorpay dashboard → Settings → API Keys). Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Optional (defaults shown; uncomment to override) ──

# Port the API listens on.
# PORT=3000

# "production" enables secure, cross-site (SameSite=None) auth cookies.
# NODE_ENV=development

# Auth token / cookie lifetime in days.
# JWT_EXPIRES_DAYS=7

# SMTP port (465 switches to implicit TLS).
# SMTP_PORT=587

# Comma-separated CORS allow-list of browser origins. Defaults to CLIENT_URL.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Absolute Google OAuth callback URL. Defaults to the relative /api/auth/google/callback.
# GOOGLE_CALLBACK_URL=https://your-app.vercel.app/api/auth/google/callback

# pino log level: trace | debug | info | warn | error | silent.
# LOG_LEVEL=info

# ── Demo seed (npm run seed:demo only; the server ignores these) ──

# Passwords for buyer@aveniq.demo and seller@aveniq.demo, at least 8 characters each.
# DEMO_BUYER_PASSWORD=
# DEMO_SELLER_PASSWORD=
